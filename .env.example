# Public site URL used for canonical links, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://keshavraj-dev.vercel.app

# EmailJS (https://dashboard.emailjs.com). These are public client keys by design;
# restrict allowed origins in the EmailJS dashboard. Leave empty to hide the form.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
